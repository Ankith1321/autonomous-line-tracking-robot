<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="yellow_line_obstacle_demo">
    <include>
      <uri>model://sun</uri>
    </include>

    <model name="flat_ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>9 5</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>9 5</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.30 0.30 0.31 1</ambient>
            <diffuse>0.32 0.32 0.33 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Production track: Clear 3.0m line from origin with obstacle at 1.5m -->
    <model name="yellow_line_segment_start">
      <static>true</static>
      <pose>1.5 0.0 0.012 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>3.0 0.16 0.014</size>
            </box>
          </geometry>
          <material>
            <ambient>0.92 0.74 0.05 1</ambient>
            <diffuse>0.95 0.78 0.05 1</diffuse>
            <specular>0.05 0.05 0.02 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Static obstacle directly on line center (perfect blocking position) -->
    <model name="obstacle_box_static_offset">
      <static>true</static>
      <pose>1.5 0.0 0.18 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.30 0.30 0.36</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.30 0.30 0.36</size>
            </box>
          </geometry>
          <material>
            <ambient>0.80 0.32 0.03 1</ambient>
            <diffuse>0.85 0.35 0.05 1</diffuse>
            <specular>0.25 0.25 0.20 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
